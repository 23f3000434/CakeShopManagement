# Copy these values into Vercel's server-side Environment Variables.
APP_ENV=production

# Aiven PostgreSQL Service URI (copy directly from Aiven Console overview):
# Example: postgresql://avnadmin:YOUR_PASSWORD@pg-xxxxxxxx-your-org.aivencloud.com:PORT/defaultdb
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_PORT/defaultdb

# SSL mode: 'require' enables TLS connection to Aiven without mounting custom certificates on Vercel
DB_SSLMODE=require

# App and JWT Secrets (must each be >= 32 characters)
SECRET_KEY=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Production cookie settings
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax

# Shop timezone (IANA format, e.g. Asia/Kolkata, UTC, America/New_York)
SHOP_TIMEZONE=Asia/Kolkata

