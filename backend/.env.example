# Generate long random values before deploying.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Local development works without DATABASE_URL and uses a local SQLite file.
# Aiven example (keep credentials out of source control):
# DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:YOUR_PORT/defaultdb
DATABASE_URL=

# Production requires Aiven's CA bundle and certificate verification.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/absolute/path/to/ca.pem

FLASK_ENV=development
APP_ENV=development
SHOP_TIMEZONE=Asia/Kolkata
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# Set these on the HTTPS production domain. Keep false for localhost HTTP.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Comma-separated only when hosting the React app separately (e.g. https://app.example.com)
# Production accepts exact HTTPS origins only; never use *.
# For a cross-site browser deployment, use JWT_COOKIE_SAMESITE=None.
# CORS_ORIGINS=
